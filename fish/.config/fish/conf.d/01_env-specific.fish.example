# ======================================== 
# The mainly entrypoint of code repository
# set -gx CODE_HOME /tmp/code

# ========================================
# Optional zoxide runtime database and serialized background disk snapshots.
# Enable only on machines with slow synchronous database writes. Unset/false
# keeps the plugin's normal behavior on any operating system.
# set -gx ZOXIDE_RUNTIME_ENABLED true
#
# Defaults to XDG_RUNTIME_DIR. If unavailable, specify an existing writable
# directory on fast or memory-backed storage; a temp directory is not always RAM.
# set -gx ZOXIDE_RUNTIME_DIR "/path/to/fast-runtime"
#
# ========================================
# Java homes vary by operating system and package manager.
# Intel macOS with Homebrew:
# set -gx JAVA_HOME "/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
#
# Apple Silicon macOS with Homebrew:
# set -gx JAVA_HOME "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
#
# Arch Linux:
# set -gx JAVA_HOME "/usr/lib/jvm/java-21-openjdk"

# ========================================
# Android SDK locations vary by operating system and installation method.
# macOS with Android Studio:
# set -gx ANDROID_HOME "$HOME/Library/Android/sdk"
#
# Linux with Android Studio:
# set -gx ANDROID_HOME "$HOME/Android/Sdk"
#
# Arch Linux with a system or AUR SDK package:
# set -gx ANDROID_HOME "/opt/android-sdk"
#
# Flutter location
# set -gx FLUTTER_HOME "$HOME/flutter"
#
# ========================================
# optional others
# set -gx SPECIFIC_BISON_HOME "/usr/local/opt/bison"
# set -gx SPECIFIC_LIBPQ_HOME "/usr/local/opt/libpq"
