      "discord": "",
      "spotify": "",
      "wechat": "󰘑",
      "org.kde.kdeconnect.app": "󰦉",
      // --- Graphics & Visual ---
      "xdg-desktop-portal-gtk": "",
      "nemo": "",
      "yazi": "󰇥",
      "imv": "󰄄",
      "swappy": "󰄄",
      "org.gnome.FileRoller": "",
      "vlc": "󰕼",
      "mpv": "󰕼",
      // --- System ---
      "blueman-manager": "",
      "pavucontrol": "󱕂",
