{
  "pulseaudio": {
    "format": "{icon}  {volume}%  {format_source}",
    "format-muted": "󰝛",
    "format-source": "  {volume}%",
    "format-source-muted": "",
    "format-bluetooth": "  {icon}  {volume}%  {format_source}",
    "format-bluetooth-muted": "󰂲  {icon}  {volume}%  {format_source}",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋋",
      "hands-free": "󰋋",
      "default": [
        "󰝚"
      ]
    },
    "on-click": "pavucontrol"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },
  "custom/cava": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/cava.sh"
  },
  "custom/song-lyc": {
    "exec": "~/.config/waybar/scripts/netease-music.sh lyc",
    "interval": 1
  },
  "custom/song-title": {
    "exec": "~/.config/waybar/scripts/netease-music.sh title",
    "interval": 1
  },
  "custom/song-process": {
    "exec": "~/.config/waybar/scripts/netease-music.sh process",
    "interval": 1
  },
  "custom/song-status": {
    "exec": "~/.config/waybar/scripts/netease-music.sh icons",
    "interval": 1
  }
}
